<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         point="org.eclipse.ui.commands">
      <command
            id="ru.edt.gitremotedisabler.toggleRemote"
            name="Отключить или включить удаленный репозиторий">
      </command>
   </extension>

   <extension
         point="org.eclipse.ui.handlers">
      <handler
            commandId="ru.edt.gitremotedisabler.toggleRemote"
            class="ru.edt.gitremotedisabler.ToggleRemoteHandler">
         <enabledWhen>
            <with
                  variable="selection">
               <count
                     value="1">
               </count>
               <iterate
                     ifEmpty="false"
                     operator="and">
                  <instanceof
                        value="org.eclipse.egit.ui.internal.repository.tree.RemoteNode">
                  </instanceof>
               </iterate>
            </with>
         </enabledWhen>
      </handler>
   </extension>

   <extension
         point="org.eclipse.ui.menus">
      <!-- Один пункт, встаёт прямо перед «Удалить удаленный репозиторий».
           Текст и иконка выставляются обработчиком (IElementUpdater) по
           текущему состоянию remote: «Отключить…» либо «Включить…». -->
      <menuContribution
            allPopups="false"
            locationURI="popup:org.eclipse.egit.ui.RepositoriesView?before=org.eclipse.ui.edit.delete">
         <command
               commandId="ru.edt.gitremotedisabler.toggleRemote"
               icon="icons/obj16/remote_disabled.png"
               label="Отключить удаленный репозиторий"
               style="push">
            <visibleWhen
                  checkEnabled="false">
               <with
                     variable="selection">
                  <count
                        value="1">
                  </count>
                  <iterate
                        ifEmpty="false"
                        operator="and">
                     <instanceof
                           value="org.eclipse.egit.ui.internal.repository.tree.RemoteNode">
                     </instanceof>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>

</plugin>
